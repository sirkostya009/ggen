#!/usr/bin/env bash
# pre-commit: run golangci-lint --fix on the root module + bench.
# Enable for this repo with:
#   git config core.hooksPath .githooks

set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

GOEXPERIMENT=${GOEXPERIMENT:-jsonv2}
export GOEXPERIMENT

# Snapshot the staging area BEFORE running lint. Only files that were
# already staged get re-staged after --fix; otherwise unrelated worktree
# changes would silently slip into the commit.
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACM | grep -E '\.go$' || true)

run() {
	local dir=$1
	printf "\e[1;2m$ \e[22;1mgolangci-lint \e[22mrun --fix \e[93m$dir\e[0m\n"
	(cd "$dir" && golangci-lint run --fix)
}

run .
if [ -f bench/go.mod ]; then
	run bench
fi

if [ ${#staged[@]} -gt 0 ]; then
	# Re-stage only previously-staged files that --fix rewrote.
	restage=()
	for f in "${staged[@]}"; do
		if ! git diff --quiet -- "$f"; then
			restage+=("$f")
		fi
	done
	if [ ${#restage[@]} -gt 0 ]; then
		echo "pre-commit: re-staging files modified by --fix:"
		printf '  %s\n' "${restage[@]}"
		git add -- "${restage[@]}"
	fi
fi
